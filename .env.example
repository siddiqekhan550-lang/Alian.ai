# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# OpenAI Image Generation API Configuration
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="dall-e-3"

# Runway Video Generation API Configuration
RUNWAY_API_KEY=""
RUNWAY_VIDEO_MODEL="gen3a_turbo"

# Supabase Authentication & PostgreSQL Database Configuration
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="alien-ai-media"

# Credit Accounting Schedule (Enforced on backend)
IMAGE_CREDIT_COST=5
VIDEO_CREDIT_COST_4S=5
VIDEO_CREDIT_COST_5S=8
VIDEO_CREDIT_COST_8S=10
VIDEO_CREDIT_COST_10S=15
NEW_USER_WELCOME_CREDITS=50

# Server session / Security
JWT_SECRET="alien-ai-secure-secret-token-key"
PORT=3000
